# ═══ إعدادات النبضة ═══
# انسخ هذا الملفّ باسم .env واكتب فيه قيمك. وهو مستثنى من git.

# مفتاح لوحة المالك على /console — طويلٌ وعشوائي، ولا يُشارَك.
# إن تُرك فارغاً وُلّد مفتاحٌ مؤقّت عند كل تشغيل وطُبع في السجلّ.
NABDA_OWNER_KEY=

# منفذ السيرفر (افتراضه 3000)
# PORT=3000

# قاعدة السجلّ — PostgreSQL. مطلوبةٌ دائماً: بلا رابطٍ لا يُقلع السيرفر.
# محلياً:  postgres://localhost/nabda
# وعلى المنصّة تُحقَن من القاعدة المُدارة عند ربطها بالتطبيق.
DATABASE_URL=

# تعميةُ الاتصال تُطفأ للقواعد المحليّة وحدها — والمنصّة لا تُطفئها.
# PGSSL=off
